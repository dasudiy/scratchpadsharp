<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ScratchpadSharp.Views"
    xmlns:vm="using:ScratchpadSharp.ViewModels"
    xmlns:converters="using:ScratchpadSharp.Converters"
    x:Class="ScratchpadSharp.Views.MainWindow"
    Title="ScratchpadSharp"
    Icon="/Assets/app-icon.png"
    Width="1200"
    Height="800"
    Background="#FFFFFF"
    WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+F" Command="{Binding FormatCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ExecuteCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding CancelCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding ManageReferencesCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <converters:HighlightBoolConverter x:Key="HighlightBoolConverter" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Toolbar (Rider-style action bar) -->
        <Border DockPanel.Dock="Top" Classes="rider-header">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,4" VerticalAlignment="Center">
                <Button Classes="rider-run-btn"
                        Command="{Binding ExecuteCommand}"
                        Content="▶  Run"
                        ToolTip.Tip="Execute Script (F5)" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding CancelCommand}"
                        Content="Stop"
                        ToolTip.Tip="Cancel (Shift+F5)" />
                <Border Width="1" Background="#DCDCDC" Margin="4,2" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding OpenCommand}"
                        Content="Open"
                        ToolTip.Tip="Open File (Ctrl+O)" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding SaveCommand}"
                        Content="Save"
                        ToolTip.Tip="Save (Ctrl+S)" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding FormatCommand}"
                        Content="Format"
                        ToolTip.Tip="Format Document (Ctrl+Alt+F)" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding ManageReferencesCommand}"
                        Content="References"
                        ToolTip.Tip="Manage References (F4)" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="#F2F2F2"
                BorderBrush="#DCDCDC"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Margin="10,0,0,0"
                           Text="{Binding StatusBarPath}"
                           Foreground="#6E6E6E"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="0"
                            Margin="0,0,8,0">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#6E6E6E"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Width="1" Height="14" Background="#DCDCDC" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding CursorPosition}"
                               Foreground="#6E6E6E"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="UTF-8"
                               Foreground="#6E6E6E"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="C#"
                               Foreground="#6E6E6E"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="4 spaces"
                               Foreground="#6E6E6E"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab strip + editor content -->
        <Grid RowDefinitions="Auto,*" Background="#FFFFFF">
            <Border Grid.Row="0" Classes="rider-tab-strip">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Classes="rider-new-tab-btn"
                            Content="+"
                            Command="{Binding NewTabCommand}"
                            ToolTip.Tip="New Tab (Ctrl+N)" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ScriptTabViewModel">
                                    <views:EditorTabHeader DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                              Content="{Binding SelectedTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ScriptTabViewModel">
                        <views:ScriptTabView DataContext="{Binding}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

    </DockPanel>
</Window>
