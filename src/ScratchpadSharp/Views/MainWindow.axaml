<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ScratchpadSharp.Views"
    xmlns:vm="using:ScratchpadSharp.ViewModels"
    xmlns:converters="using:ScratchpadSharp.Converters"
    x:Class="ScratchpadSharp.Views.MainWindow"
    Title="ScratchpadSharp"
    Icon="/Assets/app-icon.png"
    Width="1200"
    Height="800"
    Background="#FBFCFD"
    WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+F" Command="{Binding FormatCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ExecuteCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding CancelCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding ManageReferencesCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <converters:HighlightBoolConverter x:Key="HighlightBoolConverter" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="rider-header">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,4" VerticalAlignment="Center">
                <Button Classes="rider-run-btn"
                        Command="{Binding ExecuteCommand}"
                        ToolTip.Tip="Execute Script (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="▶" FontSize="11" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="Cancel (Shift+F5)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="■" FontSize="11" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Border Classes="rider-toolbar-sep" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding OpenCommand}"
                        ToolTip.Tip="Open File (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="📂" FontSize="12" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="💾" FontSize="12" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding FormatCommand}"
                        ToolTip.Tip="Format Document (Ctrl+Alt+F)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="≡" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="Format" />
                    </StackPanel>
                </Button>
                <Border Classes="rider-toolbar-sep" />
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding ManageReferencesCommand}"
                        ToolTip.Tip="Manage References (F4)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="⚙" FontSize="12" />
                        <TextBlock Text="References" />
                    </StackPanel>
                </Button>
                <Button Classes="rider-toolbar-btn"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="☰" FontSize="12" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Classes="rider-status-bar">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Margin="12,0,0,0"
                           Text="{Binding StatusBarPath}"
                           Classes="rider-status-text" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="0"
                            Margin="0,0,12,0">
                    <TextBlock Text="{Binding StatusText}"
                               Classes="rider-status-text"
                               Margin="0,0,12,0" />
                    <Border Classes="rider-status-sep" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding CursorPosition}"
                               Classes="rider-status-text"
                               Margin="0,0,12,0" />
                    <Border Classes="rider-status-sep" Margin="0,0,12,0" />
                    <TextBlock Text="UTF-8"
                               Classes="rider-status-text"
                               Margin="0,0,12,0" />
                    <Border Classes="rider-status-sep" Margin="0,0,12,0" />
                    <TextBlock Text="C#"
                               Classes="rider-status-text"
                               Margin="0,0,12,0" />
                    <Border Classes="rider-status-sep" Margin="0,0,12,0" />
                    <TextBlock Text="4 spaces"
                               Classes="rider-status-text" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab strip + editor content -->
        <Grid RowDefinitions="Auto,*" Background="{StaticResource SurfaceRaisedBrush}">
            <Border Grid.Row="0" Classes="rider-tab-strip">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Classes="rider-new-tab-btn"
                            Content="+"
                            Command="{Binding NewTabCommand}"
                            ToolTip.Tip="New Tab (Ctrl+N)" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ScriptTabViewModel">
                                    <views:EditorTabHeader DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                              Content="{Binding SelectedTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ScriptTabViewModel">
                        <views:ScriptTabView DataContext="{Binding}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

    </DockPanel>
</Window>
