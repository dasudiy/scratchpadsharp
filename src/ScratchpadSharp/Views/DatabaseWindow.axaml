<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScratchpadSharp.ViewModels"
        x:Class="ScratchpadSharp.Views.DatabaseWindow"
        x:DataType="vm:DatabaseViewModel"
        Title="Database"
        Width="860"
        Height="640"
        Background="#FBFCFD"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">
    <Border Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Spacing="10">
        <TextBlock Text="Connection"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Left"
                     Width="120"
                     Text="Provider"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <ComboBox Margin="12,0,0,0"
                    ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProvider}"
                    MinWidth="200"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Left"
                     Width="120"
                     Text="Connection string"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBox Margin="12,0,0,0"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="56"
                   Text="{Binding ConnectionString}" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Test Connection"
                  Command="{Binding TestConnectionCommand}"
                  Background="{StaticResource AccentBrush}"
                  Foreground="White"
                  BorderThickness="0"
                  Padding="14,6"
                  CornerRadius="6"
                  Cursor="Hand" />
          <Button Content="Apply to query"
                  Command="{Binding ApplyToQueryCommand}"
                  Background="Transparent"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{StaticResource TextSecondaryBrush}"
                  Padding="14,6"
                  CornerRadius="6"
                  Cursor="Hand" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   FontSize="11.5"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="12,8">
      <TabItem Header="Schema">
        <Grid RowDefinitions="Auto,*" Margin="4">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Refresh Schema"
                    Command="{Binding RefreshSchemaCommand}"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="12,5"
                    CornerRadius="6"
                    Cursor="Hand" />
            <Button Content="Scaffold selected"
                    Command="{Binding ScaffoldSelectedCommand}"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="12,5"
                    CornerRadius="6"
                    Cursor="Hand" />
            <Button Content="Scaffold all"
                    Command="{Binding ScaffoldAllCommand}"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="12,5"
                    CornerRadius="6"
                    Cursor="Hand" />
          </StackPanel>
          <Border Grid.Row="1"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Background="White"
                  Padding="4">
            <TreeView ItemsSource="{Binding SchemaRoots}"
                      SelectedItem="{Binding SelectedNode}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding DisplayText}"
                             FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                             FontSize="12.5" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="SQL">
        <Grid RowDefinitions="Auto,*,Auto,*" Margin="4">
          <TextBlock Text="Ad-hoc SQL (host ADO.NET)"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Margin="0,0,0,6" />
          <TextBox Grid.Row="1"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                   FontSize="12.5"
                   Text="{Binding SqlText}"
                   MinHeight="100" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <Button Content="Execute"
                    Command="{Binding ExecuteSqlCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,6"
                    CornerRadius="6"
                    Cursor="Hand" />
          </StackPanel>
          <TextBox Grid.Row="3"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                   FontSize="12"
                   Text="{Binding SqlResultText}" />
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="Close"
                Click="OnCloseClick"
                Background="Transparent"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Foreground="{StaticResource TextSecondaryBrush}"
                Padding="14,6"
                CornerRadius="6"
                Cursor="Hand"
                HorizontalAlignment="Right" />
        <TextBlock Text="Scaffold inserts EF entity/DbContext code into the active script. SQL runs on the host, not inside the script ALC."
                   VerticalAlignment="Center"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
