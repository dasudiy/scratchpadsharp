<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ScratchpadSharp.Views"
             xmlns:dock="using:ScratchpadSharp.Dock"
             x:Class="ScratchpadSharp.Views.Dock.QueriesToolView"
             x:DataType="dock:QueriesTool">
  <views:QueriesSidebarView DataContext="{Binding Sidebar}" />
</UserControl>
