<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ScratchpadSharp.Views"
             xmlns:dock="using:ScratchpadSharp.Dock"
             x:Class="ScratchpadSharp.Views.Dock.ModulesToolView"
             x:DataType="dock:ModulesTool">
  <views:ModulesSidebarView DataContext="{Binding Sidebar}" />
</UserControl>
