<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ScratchpadSharp.Views"
             xmlns:dock="using:ScratchpadSharp.Dock"
             x:Class="ScratchpadSharp.Views.Dock.ScriptDocumentView"
             x:DataType="dock:ScriptDocument">
  <views:ScriptTabView DataContext="{Binding Tab}" />
</UserControl>
