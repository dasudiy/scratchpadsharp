<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchpadSharp.ViewModels"
             x:Class="ScratchpadSharp.Views.QueriesSidebarView"
             x:DataType="vm:QueriesSidebarViewModel">
  <UserControl.Resources>
    <vm:QueryTreeIconConverter x:Key="QueryTreeIconConverter" />
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">0</Thickness>

    <StreamGeometry x:Key="QueryTreeCollapsedChevron">M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z</StreamGeometry>
    <StreamGeometry x:Key="QueryTreeExpandedChevron">M0,1 L10,10 20,1 19,0 10,8 1,0 Z</StreamGeometry>
    <Geometry x:Key="QueryFolderIcon">M2 4h6l2 2h10v12H2V4z</Geometry>
    <Geometry x:Key="QueryFileIcon">M6 2h8l4 4v14H6V2zm8 0v4h4</Geometry>
    <Geometry x:Key="QueryPackageIcon">M4 4h16v4H4V4zm0 6h16v10H4V10z</Geometry>

    <ControlTheme x:Key="QueryTreeExpandChevron" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  Width="14"
                  Height="20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
            <Path x:Name="ChevronPath"
                  Width="10"
                  Height="10"
                  Data="{StaticResource QueryTreeCollapsedChevron}"
                  Fill="{DynamicResource TreeViewItemForeground}"
                  Stretch="Uniform"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#ChevronPath">
        <Setter Property="Data" Value="{StaticResource QueryTreeExpandedChevron}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Theme" Value="{StaticResource QueryTreeExpandChevron}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TreeViewItem:not(:empty) /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom"
            Padding="8,6"
            Background="{StaticResource HeaderBgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}" />
    </Border>

    <ScrollViewer Padding="0,2">
      <StackPanel>
        <DockPanel x:Name="QueryRootRow"
                   Margin="4,6,4,0"
                   MinHeight="20"
                   PointerReleased="OnRootRowPointerReleased">
          <Button DockPanel.Dock="Right"
                  Classes="rider-side-panel-btn"
                  Content="↻"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Refresh" />
          <StackPanel Orientation="Horizontal"
                      Spacing="4"
                      VerticalAlignment="Center">
            <Panel Width="10" Height="10" VerticalAlignment="Center">
              <Path Width="10"
                    Height="10"
                    IsVisible="{Binding !RootNode.IsExpanded}"
                    Data="{StaticResource QueryTreeCollapsedChevron}"
                    Fill="{DynamicResource TreeViewItemForeground}"
                    Stretch="Uniform" />
              <Path Width="10"
                    Height="10"
                    IsVisible="{Binding RootNode.IsExpanded}"
                    Data="{StaticResource QueryTreeExpandedChevron}"
                    Fill="{DynamicResource TreeViewItemForeground}"
                    Stretch="Uniform" />
            </Panel>
            <PathIcon Width="14"
                      Height="14"
                      VerticalAlignment="Center"
                      Data="{StaticResource QueryFolderIcon}"
                      Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{Binding RootNode.Name}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" />
          </StackPanel>
        </DockPanel>

        <TreeView x:Name="QueryTree"
                  ItemsSource="{Binding RootNode.Children}"
                  IsVisible="{Binding RootNode.IsExpanded}"
                  SelectedItem="{Binding SelectedNode}"
                  SelectionMode="Single"
                  Background="Transparent"
                  Margin="12,0,0,0">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:QueryTreeNode"
                            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <PathIcon Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Data="{Binding Kind, Converter={StaticResource QueryTreeIconConverter}}"
                        Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Text="{Binding Name}"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Command="{Binding OpenSelectedCommand}" />
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
