<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchpadSharp.ViewModels"
             x:Class="ScratchpadSharp.Views.QueriesSidebarView"
             x:DataType="vm:QueriesSidebarViewModel"
             Focusable="True"
             KeyDown="OnKeyDown">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Resources>
    <vm:QueryTreeIconConverter x:Key="QueryTreeIconConverter" />
    <vm:QueryTreeIconBrushConverter x:Key="QueryTreeIconBrushConverter" />
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">0</Thickness>

    <StreamGeometry x:Key="QueryTreeCollapsedChevron">M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z</StreamGeometry>
    <StreamGeometry x:Key="QueryTreeExpandedChevron">M0,1 L10,10 20,1 19,0 10,8 1,0 Z</StreamGeometry>
    <Geometry x:Key="QueryFolderIcon">M2 4h6l2 2h10v12H2V4z</Geometry>

    <ControlTheme x:Key="QueryTreeExpandChevron" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  Width="14"
                  Height="20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
            <Path x:Name="ChevronPath"
                  Width="10"
                  Height="10"
                  Data="{StaticResource QueryTreeCollapsedChevron}"
                  Fill="{DynamicResource TreeViewItemForeground}"
                  Stretch="Uniform"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#ChevronPath">
        <Setter Property="Data" Value="{StaticResource QueryTreeExpandedChevron}" />
      </Style>
    </ControlTheme>

    <ContextMenu x:Key="QueryTreeContextMenu">
      <MenuItem Header="New Folder"
                Command="{Binding NewFolderCommand}"
                IsVisible="{Binding IsDirectorySelected}" />
      <MenuItem Header="New Query"
                Command="{Binding NewQueryCommand}"
                IsVisible="{Binding IsDirectorySelected}" />
      <MenuItem Header="Open"
                Command="{Binding OpenSelectedCommand}"
                IsVisible="{Binding IsPackageSelected}" />
      <MenuItem Header="Rename"
                InputGesture="F2"
                Command="{Binding RenameCommand}"
                IsVisible="{Binding CanRenameSelected}" />
      <MenuItem Header="Pack"
                Command="{Binding PackCommand}"
                IsVisible="{Binding IsFolderPackageSelected}" />
      <MenuItem Header="Unpack"
                Command="{Binding UnpackCommand}"
                IsVisible="{Binding IsPackageFileSelected}" />
      <Separator IsVisible="{Binding IsPackageSelected}" />
      <MenuItem Header="Open Containing Folder"
                Command="{Binding OpenContainingFolderCommand}"
                IsVisible="{Binding CanOpenContainingFolderSelected}" />
      <Separator />
      <MenuItem Header="Delete"
                InputGesture="Delete"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding CanDeleteSelected}" />
      <MenuItem Header="Refresh"
                Command="{Binding RefreshCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Theme" Value="{StaticResource QueryTreeExpandChevron}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TreeViewItem:not(:empty) /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TreeViewItem.drag-over">
      <Setter Property="Background" Value="#D6EBFF" />
    </Style>

    <Style Selector="DockPanel#QueryRootRow.drag-over">
      <Setter Property="Background" Value="#D6EBFF" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom"
            Padding="8,6"
            Background="{StaticResource HeaderBgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}" />
    </Border>

    <ScrollViewer Padding="0,2">
      <StackPanel>
        <DockPanel x:Name="QueryRootRow"
                   Margin="4,6,4,0"
                   MinHeight="20"
                   DragDrop.AllowDrop="True"
                   ContextMenu="{StaticResource QueryTreeContextMenu}"
                   PointerReleased="OnRootRowPointerReleased">
          <Button DockPanel.Dock="Right"
                  Classes="rider-side-panel-btn"
                  Content="↻"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Refresh" />
          <StackPanel Orientation="Horizontal"
                      Spacing="4"
                      VerticalAlignment="Center">
            <Panel Width="10" Height="10" VerticalAlignment="Center">
              <Path Width="10"
                    Height="10"
                    IsVisible="{Binding !RootNode.IsExpanded}"
                    Data="{StaticResource QueryTreeCollapsedChevron}"
                    Fill="{DynamicResource TreeViewItemForeground}"
                    Stretch="Uniform" />
              <Path Width="10"
                    Height="10"
                    IsVisible="{Binding RootNode.IsExpanded}"
                    Data="{StaticResource QueryTreeExpandedChevron}"
                    Fill="{DynamicResource TreeViewItemForeground}"
                    Stretch="Uniform" />
            </Panel>
            <PathIcon Width="14"
                      Height="14"
                      VerticalAlignment="Center"
                      Data="{StaticResource QueryFolderIcon}"
                      Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{Binding RootNode.Name}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" />
          </StackPanel>
        </DockPanel>

        <TreeView x:Name="QueryTree"
                  Focusable="True"
                  DragDrop.AllowDrop="True"
                  ItemsSource="{Binding RootNode.Children}"
                  IsVisible="{Binding RootNode.IsExpanded}"
                  SelectedItem="{Binding SelectedNode}"
                  SelectionMode="Single"
                  Background="Transparent"
                  Margin="12,0,0,0"
                  ContextMenu="{StaticResource QueryTreeContextMenu}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:QueryTreeNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="DragDrop.AllowDrop" Value="True" />
            <Setter Property="IsVisible" Value="{Binding !IsPlaceholder}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:QueryTreeNode"
                            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Panel Width="14" Height="14" VerticalAlignment="Center">
                <PathIcon Width="14"
                          Height="14"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Data="{Binding Kind, Converter={StaticResource QueryTreeIconConverter}}"
                          Foreground="{Binding Kind, Converter={StaticResource QueryTreeIconBrushConverter}}" />
              </Panel>
              <TextBlock Text="{Binding Name}"
                         IsVisible="{Binding !IsEditing}"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Text="{Binding EditName, Mode=TwoWay}"
                       IsVisible="{Binding IsEditing}"
                       MinWidth="120"
                       FontSize="12"
                       Padding="2,0"
                       BorderThickness="1"
                       VerticalAlignment="Center"
                       LostFocus="OnRenameTextBoxLostFocus"
                       KeyDown="OnRenameTextBoxKeyDown"
                       Loaded="OnRenameTextBoxLoaded" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
