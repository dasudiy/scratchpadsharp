<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScratchpadSharp.ViewModels"
        x:Class="ScratchpadSharp.Views.SecretPromptWindow"
        x:DataType="vm:SecretPromptViewModel"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Padding="20" Background="#FBFCFD">
    <StackPanel Spacing="14" MaxWidth="420">
      <TextBlock Text="{Binding Title}"
                 FontWeight="SemiBold"
                 FontSize="16" />
      <TextBlock Text="{Binding Prompt}"
                 TextWrapping="Wrap"
                 FontSize="12.5"
                 Opacity="0.85" />
      <TextBox PasswordChar="•"
               Watermark="Password"
               Text="{Binding Secret}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Click="OnCancelClick" />
        <Button Content="OK" Command="{Binding ConfirmCommand}" Click="OnOkClick"
                Background="#4C6EF5" Foreground="White" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
