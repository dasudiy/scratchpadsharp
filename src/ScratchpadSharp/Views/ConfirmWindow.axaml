<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScratchpadSharp.ViewModels"
        x:Class="ScratchpadSharp.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        KeyDown="OnWindowKeyDown">
  <Border Padding="20" Background="{StaticResource SurfaceBrush}">
    <StackPanel Spacing="14" MaxWidth="420">
      <TextBlock Text="{Binding Title}"
                 FontWeight="SemiBold"
                 FontSize="16"
                 Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="{Binding Prompt}"
                 TextWrapping="Wrap"
                 FontSize="12.5"
                 Foreground="{StaticResource TextSecondaryBrush}" />
      <TextBox x:Name="InputBox"
               IsVisible="{Binding ShowInput}"
               Watermark="Folder name"
               Text="{Binding InputText}"
               KeyDown="OnInputKeyDown" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel"
                IsCancel="True"
                Command="{Binding CancelCommand}"
                Click="OnCancelClick" />
        <Button x:Name="OkButton"
                Content="OK"
                IsDefault="True"
                Command="{Binding ConfirmCommand}"
                Click="OnOkClick"
                Background="{StaticResource AccentBrush}"
                Foreground="{StaticResource TextOnDarkBrush}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
