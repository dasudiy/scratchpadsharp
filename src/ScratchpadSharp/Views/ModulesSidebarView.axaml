<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchpadSharp.ViewModels"
             xmlns:conv="using:ScratchpadSharp.Converters"
             x:Class="ScratchpadSharp.Views.ModulesSidebarView"
             x:DataType="vm:ModulesSidebarViewModel">
  <UserControl.Resources>
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">0</Thickness>

    <StreamGeometry x:Key="ModuleTreeCollapsedChevron">M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z</StreamGeometry>
    <StreamGeometry x:Key="ModuleTreeExpandedChevron">M0,1 L10,10 20,1 19,0 10,8 1,0 Z</StreamGeometry>

    <ControlTheme x:Key="ModuleTreeExpandChevron" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  Width="14"
                  Height="20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
            <Path x:Name="ChevronPath"
                  Width="10"
                  Height="10"
                  Margin="0,0,0,0"
                  Data="{StaticResource ModuleTreeCollapsedChevron}"
                  Fill="{DynamicResource TreeViewItemForeground}"
                  Stretch="Uniform"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#ChevronPath">
        <Setter Property="Data" Value="{StaticResource ModuleTreeExpandedChevron}" />
      </Style>
    </ControlTheme>

    <conv:ModuleTreeIconImageConverter x:Key="ModuleTreeIconImageConverter" />
    <Geometry x:Key="ModuleTreeSpinnerIcon">M8 1.5A6.5 6.5 0 1 1 1.5 8H0a8 8 0 1 0 8-8v1.5z</Geometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Theme" Value="{StaticResource ModuleTreeExpandChevron}" />
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="12" />
    </Style>

    <Style Selector="PathIcon.module-tree-spinner">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <RotateTransform Angle="0" />
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.85"
                   IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Padding="8,6,8,4">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Classes="rider-side-panel-btn"
                Content="+"
                Command="{Binding AddDatabaseCommand}"
                ToolTip.Tip="Add database" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <PathIcon Width="12"
                    Height="12"
                    IsVisible="{Binding IsBusy}"
                    Classes="module-tree-spinner"
                    Data="{StaticResource ModuleTreeSpinnerIcon}"
                    Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Database modules"
                     Classes="rider-side-panel-title"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Padding="8,6"
            Background="{StaticResource HeaderBgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}" />
    </Border>

    <ScrollViewer Padding="0,2">
      <TreeView ItemsSource="{Binding RootNodes}"
                SelectedItem="{Binding SelectedNode}"
                SelectionMode="Single"
                Background="Transparent"
                PointerPressed="OnTreePointerPressed">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:ModuleTreeNode"
                            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Panel Width="16" Height="16" VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       IsVisible="{Binding !IsLoading}"
                       Source="{Binding ., Converter={StaticResource ModuleTreeIconImageConverter}}" />
                <PathIcon Width="13"
                          Height="13"
                          IsVisible="{Binding IsLoading}"
                          Classes="module-tree-spinner"
                          Data="{StaticResource ModuleTreeSpinnerIcon}"
                          Foreground="{StaticResource AccentBrush}" />
              </Panel>
              <TextBlock Text="{Binding Name}"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Edit connection" Command="{Binding EditConnectionCommand}" />
            <MenuItem Header="Regenerate model" Command="{Binding RegenerateModelCommand}" />
            <MenuItem Header="Add ref to query" Command="{Binding AddRefCommand}" />
            <MenuItem Header="Remove ref from query" Command="{Binding RemoveRefCommand}" />
            <MenuItem Header="Delete" Command="{Binding DeleteInstanceCommand}" />
            <Separator />
            <MenuItem Header="Take (100)" Command="{Binding Take100Command}" />
            <MenuItem Header="Count" Command="{Binding CountCommand}" />
            <Separator />
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
    </ScrollViewer>
  </DockPanel>
</UserControl>
