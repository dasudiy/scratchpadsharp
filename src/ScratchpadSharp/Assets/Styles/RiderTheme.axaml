<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:avaloniaEditEditing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
        xmlns:codeCompletion="clr-namespace:AvaloniaEdit.CodeCompletion;assembly=AvaloniaEdit">

    <!-- Modern Design System Palette -->
    <Styles.Resources>
        <!-- Core surfaces -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFCFD" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE2E6" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#EDEFF2" />
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F6F8FA" />

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F23" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#586069" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8B929A" />
        <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF" />

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2F81F7" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F6FEB" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#DDF4FF" />

        <!-- Status -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2DA44E" />
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#218B3E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D4920B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#CF222E" />

        <!-- Interactive -->
        <SolidColorBrush x:Key="HoverBgBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="ActiveBgBrush" Color="#E5E8EC" />

        <!-- Tab -->
        <SolidColorBrush x:Key="TabActiveBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TabInactiveBgBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="TabHoverBgBrush" Color="#EEF0F3" />

        <!-- Shadows -->
        <BoxShadows x:Key="Elevation1">0 1 2 #0000001A, 0 1 2 #0000000F</BoxShadows>
        <BoxShadows x:Key="Elevation2">0 4 12 #00000012, 0 2 4 #0000000A</BoxShadows>
        <BoxShadows x:Key="Elevation3">0 8 24 #00000014, 0 4 8 #0000000A</BoxShadows>
    </Styles.Resources>

    <!-- Toolbar header -->
    <Style Selector="Border.rider-header">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- Tab strip -->
    <Style Selector="Border.rider-tab-strip">
        <Setter Property="Background" Value="{StaticResource TabInactiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Tab item base -->
    <Style Selector="Border.rider-tab-item">
        <Setter Property="Background" Value="{StaticResource TabInactiveBgBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.rider-tab-item:pointerover">
        <Setter Property="Background" Value="{StaticResource TabHoverBgBrush}" />
    </Style>

    <Style Selector="Border.rider-tab-item.selected">
        <Setter Property="Background" Value="{StaticResource TabActiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <!-- Tab item selected with accent top border -->
    <Style Selector="Border.rider-tab-item.selected /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>

    <!-- New tab button -->
    <Style Selector="Button.rider-new-tab-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-new-tab-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Toolbar buttons -->
    <Style Selector="Button.rider-toolbar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-toolbar-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.rider-toolbar-btn:pressed">
        <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
    </Style>

    <!-- Run button -->
    <Style Selector="Button.rider-run-btn">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-run-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource SuccessHoverBrush}" />
    </Style>

    <Style Selector="Button.rider-run-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Tab close button -->
    <Style Selector="Button.rider-tab-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-tab-close:pointerover">
        <Setter Property="Background" Value="#E8E8EC" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Icon button in toolbar -->
    <Style Selector="Button.rider-icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-icon-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Side tool window (Modules / Solution Explorer style) -->
    <Style Selector="Border.rider-side-panel">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.rider-side-panel-header">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style Selector="TextBlock.rider-side-panel-title">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rider-side-panel-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-side-panel-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.rider-side-panel-rail">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Width" Value="28" />
    </Style>

  <Style Selector="Button.rider-side-panel-rail-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-side-panel-rail-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Tool window header (Output panel) -->
    <Style Selector="Border.rider-tool-header">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!-- Tool window button -->
    <Style Selector="Button.rider-tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rider-tool-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Editor styles -->
    <Style Selector="avaloniaEdit|TextEditor">
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>

    <!-- Output panel text -->
    <Style Selector="TextBlock.rider-output-text">
        <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas, monospace" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Status bar -->
    <Style Selector="Border.rider-status-bar">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="26" />
    </Style>

    <Style Selector="TextBlock.rider-status-text">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status bar separator -->
    <Style Selector="Border.rider-status-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="{StaticResource BorderLightBrush}" />
    </Style>

    <!-- Grid splitter -->
    <Style Selector="GridSplitter.rider-splitter">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="GridSplitter.rider-splitter:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Toolbar separator -->
    <Style Selector="Border.rider-toolbar-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Shared editor popup chrome (signature + completion) -->
    <Style Selector="Border.editor-popup">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- IntelliSense completion popup -->
    <Style Selector="codeCompletion|CompletionList">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="codeCompletion|CompletionList ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="codeCompletion|CompletionList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
    </Style>

    <Style Selector="codeCompletion|CompletionList ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
    </Style>

    <!-- Completion description tooltip -->
    <Style Selector="codeCompletion|CompletionTipContentControl">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>

    <!-- Dock layout -->
    <Style Selector="DockControl">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
    </Style>

    <Style Selector="DocumentTabStripItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="ToolTabStripItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="DocumentTabStrip">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{StaticResource TabInactiveBgBrush}" />
    </Style>

    <Style Selector="ToolChromeControl">
        <Setter Property="Background" Value="{StaticResource HeaderBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="ToolChromeControl TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

</Styles>
