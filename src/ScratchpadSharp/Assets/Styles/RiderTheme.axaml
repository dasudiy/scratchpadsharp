<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:avaloniaEditEditing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit">

    <!-- Rider-like palette -->
    <Styles.Resources>
        <SolidColorBrush x:Key="RiderChromeBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="RiderBorderBrush" Color="#DCDCDC" />
        <SolidColorBrush x:Key="RiderAccentBrush" Color="#307FFF" />
        <SolidColorBrush x:Key="RiderRunBrush" Color="#3D9A47" />
        <SolidColorBrush x:Key="RiderTextMutedBrush" Color="#6E6E6E" />
        <SolidColorBrush x:Key="RiderTextBrush" Color="#2B2B2B" />
    </Styles.Resources>

    <!-- Flat tab strip -->
    <Style Selector="TabControl.rider-tabs">
        <Setter Property="Background" Value="{StaticResource RiderChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RiderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TabControl.rider-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabControl.rider-tabs /template/ ContentPresenter#PART_SelectedContentHost">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TabControl.rider-tabs TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TabControl.rider-tabs TabItem:pointerover">
        <Setter Property="Background" Value="#EAEAEA" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextBrush}" />
    </Style>

    <Style Selector="TabControl.rider-tabs TabItem:selected">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource RiderAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextBrush}" />
    </Style>

    <Style Selector="TabControl.rider-tabs TabItem:focus">
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>

    <!-- Toolbar buttons -->
    <Style Selector="Button.rider-toolbar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.rider-toolbar-btn:pointerover">
        <Setter Property="Background" Value="#E4E4E4" />
    </Style>

    <Style Selector="Button.rider-run-btn">
        <Setter Property="Background" Value="{StaticResource RiderRunBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.rider-run-btn:pointerover">
        <Setter Property="Background" Value="#358C3E" />
    </Style>

    <Style Selector="Button.rider-run-btn:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Button.rider-tab-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#999999" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button.rider-tab-close:pointerover">
        <Setter Property="Background" Value="#DCDCDC" />
        <Setter Property="Foreground" Value="#333333" />
    </Style>

    <Style Selector="Button.rider-icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextMutedBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.rider-icon-btn:pointerover">
        <Setter Property="Background" Value="#E4E4E4" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextBrush}" />
    </Style>

    <!-- Tool window header (Output panel) -->
    <Style Selector="Border.rider-tool-header">
        <Setter Property="Background" Value="{StaticResource RiderChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RiderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style Selector="Button.rider-tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextMutedBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button.rider-tool-btn:pointerover">
        <Setter Property="Background" Value="#E4E4E4" />
        <Setter Property="Foreground" Value="{StaticResource RiderTextBrush}" />
    </Style>

    <!-- Menu bar -->
    <Style Selector="Menu.rider-menu">
        <Setter Property="Background" Value="{StaticResource RiderChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RiderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Editor (Rider-like) — do not set Foreground; it breaks SyntaxHighlighting -->
    <Style Selector="avaloniaEdit|TextEditor">
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>

</Styles>
